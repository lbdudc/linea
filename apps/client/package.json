{
  "name": "@lbdudc/linea-client",
  "version": "1.0.0",
  "description": "Lifecycle Management of SPLs and Products",
  "productName": "LINEA",
  "author": "Laboratorio de Bases de Datos (LBD) - Universidade da Coruña",
  "private": true,
  "scripts": {
    "lint": "eslint --ext .js,.vue ./",
    "format": "prettier --write \"**/*.{js,vue,scss,html,md,json}\" --ignore-path .gitignore",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:scripts": "node --test scripts/*.test.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "dev": "node scripts/copy-bango-worker.js && vite",
    "build": "node scripts/copy-bango-worker.js && vite build",
    "start": "serve -s dist --listen 4000",
    "postinstall": "node scripts/copy-monaco-workers.js && node scripts/copy-bango-worker.js"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@lbdudc/bango": "^0.2.0",
    "@primevue/themes": "^4.5.4",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/core": "^1.48.2",
    "axios": "^1.6.0",
    "buffer": "^6.0.3",
    "chart.js": "^4.5.1",
    "dompurify": "^3.4.17",
    "events": "^3.3.0",
    "material-icon-theme": "^5.40.0",
    "monaco-editor": "^0.44.0",
    "monaco-editor-workers": "~0.44.0",
    "primeicons": "^8.0.1",
    "primevue": "^4.5.5",
    "process": "^0.11.10",
    "serve": "^14.2.3",
    "socket.io-client": "^4.7.3",
    "stream-browserify": "^3.0.0",
    "util": "^0.12.5",
    "vite": "2.9.16",
    "vue": "^3.0.0",
    "vue-chartjs": "^5.3.3",
    "vue-i18n": "^9.0.0",
    "vue-router": "^4.0.0"
  },
  "devDependencies": {
    "@intlify/vite-plugin-vue-i18n": "^3.3.1",
    "@vitejs/plugin-vue": "^2.3.4",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.4.2",
    "esbuild": "0.25.5",
    "eslint": "^8.10.0",
    "eslint-config-prettier": "^8.1.0",
    "eslint-plugin-vue": "^9.0.0",
    "jsdom": "^30.1.0",
    "postcss": "^8.4.14",
    "prettier": "^2.5.1",
    "sass": "1.89.1",
    "vite-plugin-monaco-editor": "^1.1.0",
    "vitest": "^1.6.0",
    "vm-browserify": "^1.1.2",
    "vscode-languageserver-types": "~3.17.3"
  },
  "engines": {
    "node": "^20",
    "npm": ">= 10.1.0",
    "vscode": "^1.67.0",
    "yarn": ">= 1.22.19"
  },
  "license": "Apache-2.0"
}
