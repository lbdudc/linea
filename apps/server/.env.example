# ── Server ──────────────────────────────────────────────────────────────────
port=3000
# Full MongoDB connection URL (overrides db.* in properties.yml when set)
mongoUrl=

# ── GitLab OAuth ─────────────────────────────────────────────────────────────
GITLAB_HOSTNAME=https://gitlab.example.com
GITLAB_CLIENT_ID=
GITLAB_SECRET_ID=
REDIRECT_URI=http://localhost:9000

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SIGN_KEY=

# ── Plugins ──────────────────────────────────────────────────────────────────
# Which plugins are on, and their settings, belong in linea.config.yml (see deploy/linea.config.example.yml): LINEA_CONFIG is its path
# (default: /config/linea.config.yml in Docker, linea/linea.config.yml otherwise). A plugin it declares is locked in the Plugins view.
LINEA_CONFIG=
# Plugins to have on from the first start when there is no config file (comma-separated ids)
LINEA_PLUGINS=
# Git host of this deployment: local (default: the repositories live on this server), gitlab or github; see linea.config.yml `gitHosts`
GIT_PROVIDER=
# Who may install, enable and configure plugins (comma-separated git usernames)
ADMIN_USERS=
# Keys of the services that act for people: id:secret,... (a plugin's service that acts for people says which: see its README)
LINEA_SERVICE_KEYS=

# ── Domain events (optional) ─────────────────────────────────────────────────
# Comma-separated URLs that get a signed POST for each generated product; empty: nothing is sent.
# The body is HMAC-SHA256-signed with EVENT_WEBHOOK_SECRET in the X-Linea-Signature header (sha256=<hex>).
EVENT_WEBHOOK_URLS=
EVENT_WEBHOOK_SECRET=

# Pushes to GitLab/GitHub repositories reach LINEA at PUBLIC_URL/api/webhooks/<host>, signed with GIT_WEBHOOK_SECRET (they become the git:pushed
# event plugins hear about). The local git host needs neither.
PUBLIC_URL=
GIT_WEBHOOK_SECRET=

