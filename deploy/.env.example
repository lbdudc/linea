# Local settings for `docker compose up --build -d` (cp .env.example .env; .env is not in git). Secrets go in ../apps/server/.env.local.
PROXY_PORT=9000
NODE_ENV=development
REDIRECT_URI=http://localhost:9000

API_URL=
VITE_API_URL=

MONGO_URL=mongodb://mongo:27017/splalm?replicaSet=rs0&directConnection=true
SERVER_ENV_FILE=../apps/server/.env.example

PUBLIC_SERVER_URL=
EVENT_WEBHOOK_URLS=
EVENT_WEBHOOK_SECRET=

# --- quickstart (the `local` git host: LINEA keeps the repositories itself, no GitLab or GitHub needed) -------------------------
# Change both before exposing it anywhere.
JWT_SIGN_KEY=change-me-quickstart-only
ADMIN_USERS=admin
LINEA_ADMIN_PASSWORD=change-me-quickstart-only
LINEA_REGISTRY=local:registry/index
