# Production settings for `docker compose --env-file .env.prod up --build -d` (cp .env.prod.example .env.prod; .env.prod is not in git).
# The secrets (GitLab OAuth, JWT key) go in ../server/.env, see ../server/.env.example.
PROXY_PORT=18009
NODE_ENV=production
REDIRECT_URI=https://linea.example.com
PUBLIC_SERVER_URL=https://linea.example.com
API_URL=
MONGO_URL=mongodb://mongo:27017/splalm?replicaSet=rs0&directConnection=true

# GitLab as the only git host and sign-in (no `local` host): see config-gitlab/linea.config.yml
# the pipeline sets LINEA_CONFIG_DIR=./config-prod itself (from the CI/CD file variable LINEA_PROD_CONFIG); this is for running compose by hand
LINEA_CONFIG_DIR=./config-gitlab

# Who may install and switch plugins and see the settings (comma-separated git usernames)
ADMIN_USERS=your.gitlab.username

EVENT_WEBHOOK_URLS=
EVENT_WEBHOOK_SECRET=

# Catalog of registered modules and metamodels (repository with registry.json): the server lists these instead of every repo with the topic.
LINEA_REGISTRY=gitlab:linea/registry
