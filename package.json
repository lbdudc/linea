{
  "name": "linea-monorepo",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*",
    "apps/*",
    "e2e"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev -w @lbdudc/linea-server\" \"npm run dev -w @lbdudc/linea-client\"",
    "build": "npm run build -w @lbdudc/linea-core && npm run build -w @lbdudc/linea-git",
    "build:all": "npm run build && npm run build -w @lbdudc/linea-client",
    "test": "npm run build && npm test -w @lbdudc/linea-core -w @lbdudc/linea-git -w @lbdudc/linea-ci -w @lbdudc/linea-cli -w @lbdudc/linea-server -w @lbdudc/linea-client",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "publish:core": "npm run build -w @lbdudc/linea-core && npm publish -w @lbdudc/linea-core",
    "publish:git": "npm run build -w @lbdudc/linea-core -w @lbdudc/linea-git && npm publish -w @lbdudc/linea-git",
    "publish:cli": "npm run build && npm run build -w @lbdudc/linea-cli && npm publish -w @lbdudc/linea-cli",
    "publish:ci": "npm publish -w @lbdudc/linea-ci",
    "publish:sdk": "npm publish -w @lbdudc/linea-plugin-sdk",
    "docker:build": "docker build -f apps/server/Dockerfile -t linea-server . && docker build -f apps/client/Dockerfile -t linea-client .",
    "deploy:local": "cd deploy && docker compose up -d --build",
    "postinstall": "patch-package --patch-dir apps/server/patches",
    "test:e2e": "npm test -w linea-e2e"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "patch-package": "^8.0.1"
  }
}
