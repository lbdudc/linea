{
  "name": "@lbdudc/linea-git",
  "version": "0.1.0",
  "description": "The git host of LINEA, GitLab or GitHub, behind one interface: repositories, files, commits, change requests, the registry of modules and metamodels. Used by the LINEA server and the LINEA CLI.",
  "license": "Apache-2.0",
  "author": "Laboratorio de Bases de Datos (LBD) - Universidade da Coruña",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    },
    "./contract": {
      "types": "./dist/testing/contract.d.ts",
      "import": "./dist/testing/contract.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "gitlab-commando": "^0.2.7",
    "semver": "^7.8.5"
  },
  "peerDependencies": {
    "@lbdudc/linea-core": "*"
  },
  "devDependencies": {
    "@lbdudc/linea-core": "^0.1.1",
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.0",
    "@types/semver": "^7.8.0",
    "express": "^4.18.2",
    "jszip": "^3.10.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lbdudc/linea.git",
    "directory": "packages/git"
  },
  "homepage": "https://github.com/lbdudc/linea/tree/main/packages/git",
  "bugs": {
    "url": "https://github.com/lbdudc/linea/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
