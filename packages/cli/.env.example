# The Linea deployment the CLI talks to. Defaults to http://localhost:3000
# when unset; point it at your deployment, e.g. https://linea.example.com
LINEA_BASE_URL=https://linea.example.com

# Dev-only: a JWT copied from a logged-in browser session. When set, the CLI
# uses it directly, skipping /login entirely. Remove it to use the normal
# /login flow.
# LINEA_TOKEN=

# /login runs a loopback OAuth flow (like `gh auth login`): it opens your
# browser at GitLab's authorize page (host taken from the backend's own
# GET /api/users/config response — no GitLab-host configuration needed here)
# and listens on this local port for the redirect. Only change it if the
# default is already in use on your machine.
# LINEA_OAUTH_PORT=53682
