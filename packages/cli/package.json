{
  "name": "@lbdudc/linea-cli",
  "version": "0.1.1",
  "type": "module",
  "description": "LINEA from the terminal: manage software product lines and generate products. Needs the Bun runtime.",
  "main": "src/index.tsx",
  "bin": {
    "linea": "dist/index.js"
  },
  "scripts": {
    "start": "bun run src/index.tsx",
    "dev": "bun run src/index.tsx",
    "build": "bun run scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "bun": ">=1.1"
  },
  "dependencies": {
    "@lbdudc/bango": "^0.2.0",
    "@lbdudc/linea-core": "^0.1.2",
    "@lbdudc/linea-git": "^0.1.1",
    "@opentui/core": "^0.4.5",
    "@opentui/solid": "^0.4.5",
    "langium": "^4.4.0",
    "open": "^10.1.0",
    "solid-js": "1.9.12"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^5.7.0"
  },
  "license": "Apache-2.0",
  "author": "Laboratorio de Bases de Datos (LBD) - Universidade da Coruña",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lbdudc/linea.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/lbdudc/linea/tree/main/packages/cli",
  "bugs": {
    "url": "https://github.com/lbdudc/linea/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "README.md"
  ]
}
