featuremodel SplCalculator abstract feature SplCalculator {
    mandatory {
      feature base {
        optional {
          abstract feature operations {
            optional {
              feature add
              feature subtract
              feature multiply
              feature divide
              feature power
              feature square_root
            }
          }
          abstract feature capabilities {
            optional {
              feature decimal
            }
          }
        }
      }
    }
  } constraints {
  divide
    => decimal
  square_root
    => decimal
}
