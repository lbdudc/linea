featuremodel Phones
feature Phones {
  mandatory {
    feature Screen {
      alternative {
        feature Lcd
        feature Oled
      }
    }
    feature Battery
  }
  optional {
    feature Camera {
      or {
        feature Front
        feature Rear
      }
    }
    feature Gps
    abstract feature Extras {
      optional {
        feature Nfc
      }
    }
  }
}
constraints {
  Gps => Oled
  Front => Camera
  !(Nfc & Lcd)
}
